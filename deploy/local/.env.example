# Set this to the LAN IP of the machine running the containers.
# Required if you want to use Studio from other machines on the network.
IP=192.168.1.100
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
STROM_API_KEY=

# Releases to run. The dashboard builds OPEN_LIVE_IMAGE and OPEN_LIVE_STUDIO_IMAGE from
# ../open-live and ../open-live-studio (check out the matching release tag there).
STROM_IMAGE=eyevinntechnology/strom-full:0.8.1
OPEN_LIVE_IMAGE=open-live:0.8.0
OPEN_LIVE_STUDIO_IMAGE=open-live-studio:0.8.0
# Address other computers use to reach Strom (WHEP, web UI)
STROM_PUBLIC_URL=http://192.168.1.100:8080
